# Environment Configuration
NODE_ENV=development
DEBUG=qona-mbs:*

# Server
PORT=3001
HOST=localhost
API_BASE_URL=http://localhost:3001/api

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=qona_mbs_dev
DB_LOGGING=true

# Redis (Sessions & Caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345
JWT_EXPIRE=24h
JWT_REFRESH_SECRET=your-refresh-secret-key-12345
JWT_REFRESH_EXPIRE=7d

# Session
SESSION_SECRET=your-session-secret-key-12345
SESSION_EXPIRE=900000

# OTP Configuration
OTP_LENGTH=6
OTP_EXPIRE=300000
OTP_MAX_ATTEMPTS=3

# M-Pesa Configuration
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_PASSKEY=your-passkey
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=http://localhost:3001/api/webhooks/mpesa

# SMS Gateway (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_ID=your-service-id

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@example.com

# WhatsApp (Twilio)
WHATSAPP_ACCOUNT_SID=your-account-sid
WHATSAPP_AUTH_TOKEN=your-auth-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_WEBHOOK_TOKEN=your-webhook-token

# CRB (Credit Reference Bureau)
CRB_API_URL=https://api.crb.co.ke
CRB_API_KEY=your-crb-api-key

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Security
ENCRYPTION_KEY=your-encryption-key-32-chars-long-12345
IV_LENGTH=16

# Data Retention (days)
LOG_RETENTION_DAYS=7
AUDIT_LOG_RETENTION_DAYS=2555
FAILED_TXN_RETENTION_DAYS=365

# Feature Flags
FEATURE_WHATSAPP=true
FEATURE_BIOMETRIC=true
FEATURE_2FA=true
FEATURE_SIM_SWAP_DETECTION=true

# Admin Default
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
