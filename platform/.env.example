# Postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sacco
PGPOOL_MAX=20

# Required in production. Generate with: openssl rand -base64 48
JWT_SECRET=

# Set true only when a trusted load balancer sets X-Forwarded-Host.
TRUST_PROXY=false

PORT=4000
NODE_ENV=development

# Tokens
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Backups
BACKUP_DIR=./backups
BACKUP_KEEP=14
PG_DUMP=pg_dump
PG_RESTORE=pg_restore

# In-process scheduler. Leave off and use a cron/CronJob calling the CLI
# if you run more than one instance.
SCHEDULER=off
SCHEDULER_TZ=Africa/Nairobi
EOD_HOUR=22
BACKUP_HOUR=1
TOKEN_PRUNE_HOUR=3
